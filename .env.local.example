# RetireNest 本地模型配置模板：cp .env.local.example .env.local 后填值。
# `make dev` 与 `uv run --project src python run.py` 会自动读取 .env.local，
# 进程里已有的环境变量优先，文件只做补充。.env.local 不提交。
# 规则：KEY=VALUE，支持 # 注释与 export 前缀；留空的行等于没写。
# 值可以引用别的变量：${NAME} 会从进程环境或本文件前面几行取值，没有值时该项跳过。

# 必填：模型服务的 API key，也可以写成 ${DEEPSEEK_API_KEY} 之类的引用
RETIRENEST_LLM_API_KEY=

# 必填：模型名，例如 deepseek-chat、gpt-4o-mini、qwen-plus
RETIRENEST_LLM_MODEL=

# 可选：非 OpenAI 官方服务时填，例如 https://api.deepseek.com/v1
# DeepSeek、通义、Kimi 等第三方端点必须填，否则会打到 OpenAI 官方端点
RETIRENEST_LLM_BASE_URL=

# 可选：单次模型调用超时秒数，默认 60
RETIRENEST_LLM_TIMEOUT_SECONDS=
